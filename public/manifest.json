{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.4.0",
  "description": "__MSG_extensionDescription__",
  "author": "Infoxica",
  "homepage_url": "https://chatgpt-audio-controls.infoxica.com/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_extensionActionTitle__"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/settings-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/player.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-floating-ui": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Option+Shift+Y"
      },
      "description": "__MSG_visibilityCommand__"
    },
    "play-pause": {
      "description": "__MSG_command_play_pause__"
    },
    "seek-back": {
      "description": "__MSG_command_seek_back__"
    },
    "seek-forward": {
      "description": "__MSG_command_seek_forward__"
    },
    "speed-decrease": {
      "description": "__MSG_command_speed_decrease__"
    },
    "speed-increase": {
      "description": "__MSG_command_speed_increase__"
    },
    "speed-reset": {
      "description": "__MSG_command_speed_reset__"
    },
    "volume-increase": {
      "description": "__MSG_command_volume_increase__"
    },
    "volume-decrease": {
      "description": "__MSG_command_volume_decrease__"
    },
    "toggle-mute": {
      "description": "__MSG_command_toggle_mute__"
    },
    "download-audio": {
      "description": "__MSG_command_download_audio__"
    },
    "toggle-collapse": {
      "description": "__MSG_command_toggle_collapse__"
    },
    "reset-layout": {
      "description": "__MSG_command_reset_layout__"
    },
    "open-help": {
      "description": "__MSG_command_open_help__"
    },
    "open-settings": {
      "description": "__MSG_command_open_settings__"
    }
  }
}
