{
  "manifest_version": 3,
  "name": "ChatGPT Audio Controls & Read Aloud",
  "version": "1.0.0",
  "description": "Complete Read Aloud controls for ChatGPT: integrated seeker, playback speed, volume, download audio, shortcuts, and response speech buttons.",
  "author": "Infoxica",
  "homepage_url": "https://github.com/infoxica/chatgpt-audio-controls",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "ChatGPT Audio Controls"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/player.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
