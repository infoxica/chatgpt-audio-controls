{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chatgpt-audio-feedback-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "ENVIRONMENT": "local",
    "CHROME_ITEM_ID": "aifalimlfgiepmbejcemcofninobaiea",
    "EDGE_ITEM_ID": "cmhbacgmcgiolpidfjcpefkhbbeamemf",
    "RATING_MODE": "weighted",
    "EDGE_STATS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatgpt-audio-feedback-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "chatgpt-audio-feedback-staging",
      "triggers": {
        "crons": []
      },
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFmYysX2jPu8WFFj",
        "ENVIRONMENT": "staging",
        "CHROME_ITEM_ID": "aifalimlfgiepmbejcemcofninobaiea",
        "EDGE_ITEM_ID": "cmhbacgmcgiolpidfjcpefkhbbeamemf",
        "RATING_MODE": "weighted",
        "EDGE_STATS_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chatgpt-audio-feedback-staging",
          "migrations_dir": "migrations",
          "database_id": "d63139b6-978e-4282-862e-26c7d15c5941"
        }
      ],
      "secrets": {
        "required": [
          "TURNSTILE_SECRET_KEY"
        ]
      },
      "assets": {
        "directory": "../../build/site-staging",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none",
        "run_worker_first": [
          "/*",
          "!/assets/*"
        ]
      },
      "kv_namespaces": [
        {
          "binding": "STATS_KV",
          "id": "26e410b118514002b026b792e0be0413"
        }
      ]
    },
    "production": {
      "name": "chatgpt-audio-feedback",
      "routes": [
        {
          "pattern": "chatgpt-audio-controls.infoxica.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFmZI5PtqIBrKeQK",
        "ENVIRONMENT": "production",
        "CHROME_ITEM_ID": "aifalimlfgiepmbejcemcofninobaiea",
        "EDGE_ITEM_ID": "cmhbacgmcgiolpidfjcpefkhbbeamemf",
        "RATING_MODE": "weighted",
        "EDGE_STATS_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chatgpt-audio-feedback",
          "migrations_dir": "migrations",
          "database_id": "3da56913-abc9-4059-9942-4bcb38419e7f"
        }
      ],
      "secrets": {
        "required": [
          "TURNSTILE_SECRET_KEY"
        ]
      },
      "kv_namespaces": [
        {
          "binding": "STATS_KV"
        }
      ],
      "triggers": {
        "crons": [
          "0 3 * * *"
        ]
      }
    }
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "assets": {
    "directory": "../../site-dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "STATS_KV"
    }
  ]
}
