{
  "name": "chatgpt-audio-controls",
  "version": "1.2.0",
  "description": "Integrated Read Aloud and Audio Controls for ChatGPT — Seeker, Speed, Volume, Download, Shortcuts, and Response Speech Buttons.",
  "type": "module",
  "scripts": {
    "build:site": "bun run scripts/build-site.ts",
    "dev:site": "python -B scripts/preview-site.py",
    "test:site-http": "python -B tests/site_http_test.py",
    "dev": "vite",
    "build": "tsc && vite build && bun run scripts/build-content.ts && bun run build:userscript",
    "build:extension": "tsc && vite build && bun run scripts/build-content.ts",
    "build:icons": "bun run scripts/generate-icons.ts",
    "build:userscript": "bun run scripts/sync-userscript.ts",
    "package": "bun run build && bun run scripts/package-zip.ts",
    "release:check": "bun run scripts/validate-release.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chatgpt",
    "read-aloud",
    "audio-controls",
    "text-to-speech",
    "tts",
    "browser-extension",
    "manifest-v3",
    "chrome-extension",
    "userscript",
    "tampermonkey",
    "react"
  ],
  "author": "Infoxica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/infoxica/chatgpt-audio-controls"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "turndown": "^7.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
